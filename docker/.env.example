# ============================================================
# nova-dev — Artemis HA + Redis cluster + PostgreSQL HA + Consul
# Generated by `just setup` — passwords are random per machine.
# ============================================================

# Host IP advertised by redis/artemis/consul and used by clients.
# Leave empty — `just setup` auto-detects the primary interface IP.
SERVER_IP=

# ---------- Artemis (3 live + 3 backup, replication) ----------
# NOTE: cluster nodes MUST be tcp:// URIs (Artemis connector URIs require a scheme)
ARTEMIS_IMAGE=apache/activemq-artemis:latest-alpine
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis
ARTEMIS_CLUSTER_NODES=tcp://artemis-live1:61616,tcp://artemis-live2:61616,tcp://artemis-live3:61616

# ---------- Redis cluster (3 masters + 3 replicas) ----------
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=nova-redis-dev-pass
REDIS_PORT_1=7001
REDIS_PORT_2=7002
REDIS_PORT_3=7003
REDIS_PORT_4=7004
REDIS_PORT_5=7005
REDIS_PORT_6=7006

# ---------- PostgreSQL (primary + streaming replica) ----------
POSTGRES_IMAGE=postgres:18.0-alpine
DB_USERNAME=nova
DB_PASSWORD=nova-dev-pass
DB_NAME=novadb
REPLICATION_USER=replicator
REPLICATION_PASSWORD=nova-repl-dev-pass

# ---------- Consul (ACLs enabled) ----------
CONSUL_IMAGE=hashicorp/consul:latest
# filled by `just consul-setup` (acl bootstrap global-management token)
CONSUL_HTTP_TOKEN=
# gossip encryption key, generated by `just setup` (consul keygen)
CONSUL_GOSSIP_KEY=

# ============================================================
# Client-side strings (copy into your app .env)
# ============================================================

# Artemis (failover across lives; backups promote automatically)
# ACTIVEMQ_BROKER_URL=(tcp://<SERVER_IP>:61616,tcp://<SERVER_IP>:61626,tcp://<SERVER_IP>:61636)?ha=true&initialConnectAttempts=1&reconnectAttempts=3&failoverAttempts=-1

# Redis cluster
# REDIS_CLUSTER_NODES=<SERVER_IP>:7001,<SERVER_IP>:7002,<SERVER_IP>:7003,<SERVER_IP>:7004,<SERVER_IP>:7005,<SERVER_IP>:7006
# REDIS_PASSWORD=<REDIS_PASSWORD>

# PostgreSQL — primary (writes):
#   jdbc:postgresql://<SERVER_IP>:5433/novadb
# reads across both nodes (pgjdbc 42.5+):
#   jdbc:postgresql://<SERVER_IP>:5433,<SERVER_IP>:5434/novadb?targetServerType=preferSecondary&loadBalanceHosts=true

# Consul
# CONSUL_HTTP_