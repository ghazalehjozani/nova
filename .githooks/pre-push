#!/bin/sh

##############################################################################
# pre-push Hook:
#   1. Check if current branch is behind develop (force pull/rebase if so)
#   2. Determine version bump (Major/Minor/Patch) based on commits:
#       - Breaking change => Major
#       - feat => Minor
#       - otherwise => Patch
#   3. Update pom.xml, commit the new version, create a tag
#   4. Run `mvn clean compile test verify -P dev,mutation-test,architecture-test`
##############################################################################

echo "[pre-push] Starting checks..."

# (A) CHECK IF BEHIND DEVELOP
echo "[pre-push] Checking if branch is behind 'develop'..."
git fetch origin develop 2>/dev/null

LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/develop)
BASE=$(git merge-base HEAD origin/develop)

# If local = remote => up to date
if [ "$LOCAL" = "$REMOTE" ]; then
  echo "[pre-push] Branch is up-to-date with 'develop'."
elif [ "$BASE" = "$REMOTE" ]; then
  echo "ERROR: Your branch is behind 'develop'. Please pull/rebase before pushing."
  exit 1
else
  echo "WARNING: Your branch may have diverged from 'develop'. Proceed carefully."
fi

# (B) DETERMINE VERSION BUMP
# (B1) Get current version from pom.xml using Maven
CURRENT_VERSION=$(mvn help:evaluate -Dexpression=project.version -q -DforceStdout 2>/dev/null)
echo "[pre-push] Current version from pom.xml is '$CURRENT_VERSION'"

# (B2) Gather commits since 'origin/develop' to see if there's a BREAKING CHANGE or feat
COMMITS=$(git log origin/develop..HEAD --pretty=format:"%s%n%b")

IS_BREAKING=false
IS_FEAT=false

# Breaking if "BREAKING CHANGE:" or "feat!" or "fix!"
if echo "$COMMITS" | grep -Eq "(BREAKING CHANGE:|feat!|fix!)"; then
  IS_BREAKING=true
fi
# Also check for at least one standard "feat(" commit
if echo "$COMMITS" | grep -Eq "^feat\("; then
  IS_FEAT=true
fi

# (B3) Parse CURRENT_VERSION as X.Y.Z (assuming standard semver-like versioning)
MAJOR="$(echo "$CURRENT_VERSION" | cut -d '.' -f1)"
MINOR="$(echo "$CURRENT_VERSION" | cut -d '.' -f2)"
PATCH="$(echo "$CURRENT_VERSION" | cut -d '.' -f3 | sed 's/[^0-9].*//')"

if [ -z "$MAJOR" ] || [ -z "$MINOR" ] || [ -z "$PATCH" ]; then
  echo "ERROR: Unable to parse semver from '$CURRENT_VERSION'."
  echo "Make sure your version is in the form X.Y.Z or X.Y.Z-SNAPSHOT."
  exit 1
fi

# (B4) Determine new version
if [ "$IS_BREAKING" = "true" ]; then
  # Typically a major bump
  MAJOR=$((MAJOR + 1))
  MINOR=0
  PATCH=0
  NEW_VERSION="$MAJOR.$MINOR.$PATCH"
  echo "[pre-push] Detected breaking change, new version = $NEW_VERSION"
elif [ "$IS_FEAT" = "true" ]; then
  # If there's a new feature, do a minor bump
  MINOR=$((MINOR + 1))
  PATCH=0
  NEW_VERSION="$MAJOR.$MINOR.$PATCH"
  echo "[pre-push] Detected feature commit, new version = $NEW_VERSION"
else
  # Otherwise patch
  PATCH=$((PATCH + 1))
  NEW_VERSION="$MAJOR.$MINOR.$PATCH"
  echo "[pre-push] No breaking changes or new features, patch bump => $NEW_VERSION"
fi

# (C) BUMP VERSION IN POM.XML AND COMMIT/TAG
echo "[pre-push] Updating pom.xml to version $NEW_VERSION..."
mvn versions:set -DnewVersion="$NEW_VERSION" -DgenerateBackupPoms=false > /dev/null
if [ $? -ne 0 ]; then
  echo "ERROR: Maven version:set failed."
  exit 1
fi

git add pom.xml
git commit -m "chore: bump version to $NEW_VERSION"
git tag "v$NEW_VERSION" -m "Release v$NEW_VERSION"

# (D) RUN FULL MAVEN BUILD
echo "[pre-push] Running full build with dev,mutation-test,architecture-test profiles..."
mvn clean compile test verify \
  -DskipTests=false -DskipIntegrationTests=false \
  -P dev,mutation-test,architecture-test

RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "ERROR: Maven verify failed. Aborting push."
  # Optional: revert the version bump commit + remove the tag
  git reset --hard HEAD~1
  git tag -d "v$NEW_VERSION" 2>/dev/null
  exit 1
fi

echo "[pre-push] All checks passed. Proceeding with push..."
exit 0

