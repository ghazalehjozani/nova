#!/bin/sh

##############################################################################
# commit-msg Hook:
#   1. Block commits on master/stage/develop
#   2. Enforce Git Flow branch naming (feature|hotfix|release/<kebab-case>-<digits>...)
#   3. Validate commit message format: type(TASK-123[:TASK-456]) + short description
#   4. Enforce 15–100 char commit header length
#   5. Disallow "WIP"/"TODO"/"FIXME" in the header
#   6. Require GPG-signed commits
#   7. If commit is "feat!" or "fix!", require "BREAKING CHANGE:" in the body
##############################################################################

# (A) FETCH THE CURRENT BRANCH
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# (A1) DISALLOW COMMITS ON MASTER/STAGE/DEVELOP
if [ "$BRANCH_NAME" = "master" ] || [ "$BRANCH_NAME" = "stage" ] || [ "$BRANCH_NAME" = "develop" ]; then
  echo "ERROR: Commits are not allowed directly on '$BRANCH_NAME'."
  echo "Please create a feature/hotfix/release branch."
  exit 1
fi

# (A2) GIT FLOW BRANCH NAMING
# Allowed pattern example: feature/my-cool-service-123, hotfix/urgent-issue-456, release/v1-1-0, etc.
BRANCH_REGEX='^(feature|hotfix|release)\/[a-z0-9]+(-[a-z0-9]+)*-[0-9]+(-[a-z0-9]+)*$'
if ! echo "$BRANCH_NAME" | grep -Eq "$BRANCH_REGEX"; then
  echo "ERROR: Invalid branch name '$BRANCH_NAME'."
  echo "Must match pattern: feature|hotfix|release/<kebab-case>-<digits>..."
  exit 1
fi

# (B) READ THE COMMIT MESSAGE HEADER (first line)
COMMIT_MSG_FILE="$1"
COMMIT_MSG_HEAD=$(head -n1 "$COMMIT_MSG_FILE")

# (B1) ENFORCE MIN/MAX LENGTH
HEADER_LENGTH=$(echo "$COMMIT_MSG_HEAD" | wc -c | tr -d ' ')
if [ "$HEADER_LENGTH" -lt 15 ] || [ "$HEADER_LENGTH" -gt 100 ]; then
  echo "ERROR: Commit header must be 15–100 characters!"
  echo "Header is: '$COMMIT_MSG_HEAD'"
  exit 1
fi

# (B2) DISALLOW "WIP", "TODO", "FIXME" IN COMMIT HEADER
if echo "$COMMIT_MSG_HEAD" | grep -iE "(wip|todo|fixme)"; then
  echo "ERROR: Found 'WIP'/'TODO'/'FIXME' in commit message header."
  echo "Please remove or address these placeholders."
  exit 1
fi

# (B3) ENFORCE COMMIT MESSAGE FORMAT
# e.g. feat(FOO-1234:BAR-5678): short description
COMMIT_REGEX='^(feat|fix|docs|style|refactor|test|chore)\([A-Z]{2,}-[0-9]+(:[A-Z]{2,}-[0-9]+){0,2}\):\s.+$'
if ! echo "$COMMIT_MSG_HEAD" | grep -Eq "$COMMIT_REGEX"; then
  echo "ERROR: Invalid commit message format."
  echo "Expected: type(TASK-123[:TASK-456[:TASK-789]]): short description"
  exit 1
fi

# (B4) CHECK GPG SIGNATURE
# We look at the last commit for "gpg:" in the log. This can be tricky locally,
# because the commit is just being created. Typically, if the user does `git commit -S`, it works.
HAS_GPG_SIGNATURE=$(git log --show-signature -1 HEAD 2>/dev/null | grep -c "gpg:")
if [ "$HAS_GPG_SIGNATURE" -eq 0 ]; then
  echo "ERROR: Commit is not GPG-signed!"
  echo "Please see docs/gpg-signed-commits-guide.md for instructions."
  exit 1
fi

# (B5) REQUIRE "BREAKING CHANGE:" FOOTER IF type! (e.g. feat!(...))
if echo "$COMMIT_MSG_HEAD" | grep -Eq '^(feat|fix)\!'; then
  COMMIT_MSG_BODY=$(tail -n +2 "$COMMIT_MSG_FILE")
  if ! echo "$COMMIT_MSG_BODY" | grep -q "BREAKING CHANGE:"; then
    echo "ERROR: This commit indicates a major/breaking change but no 'BREAKING CHANGE:' found in body."
    exit 1
  fi
fi

# All checks passed
exit 0

