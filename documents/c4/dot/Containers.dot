digraph {
  compound=true
  graph [fontname="Arial", rankdir=TB, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Container View: Trade Loan Service</font><br /><font point-size="24">Container diagram showing application and infrastructure</font>>

  1 [id=1,shape=rect, label=<<font point-size="34">ESB</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Enterprise Service Bus —<br />routes business loan-lifecycle<br />requests from upstream<br />channels</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]
  2 [id=2,shape=rect, label=<<font point-size="34">TPS SSO</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">OAuth2/OIDC identity provider<br />(token validation + JWKS)</font>>, style=filled, color="#801313", fillcolor="#b71c1c", fontcolor="#ffffff"]
  3 [id=3,shape=rect, label=<<font point-size="34">FCB Core Banking</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Legacy core banking —<br />accounts, postings,<br />collateral, sanctions</font>>, style=filled, color="#624d45", fillcolor="#8d6e63", fontcolor="#ffffff"]
  4 [id=4,shape=rect, label=<<font point-size="34">OpenTelemetry<br />Collector</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">OpenTelemetry collector —<br />traces, metrics, logs</font>>, style=filled, color="#005f56", fillcolor="#00897b", fontcolor="#ffffff"]
  5 [id=5,shape=rect, label=<<font point-size="34">Consul</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Runtime configuration store<br />(Consul KV, fed by GitOps)</font>>, style=filled, color="#4c352d", fillcolor="#6d4c41", fontcolor="#ffffff"]
  24 [id=24,shape=rect, label=<<font point-size="34">Operator / Admin</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Bank operations /<br />administrator — monitors and<br />remediates the service</font>>, style=filled, color="#402a4d", fillcolor="#5c3d6e", fontcolor="#ffffff"]

  subgraph cluster_6 {
    margin=25
    label=<<font point-size="24"><br />Trade Loan Service</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    10 [id=10,shape=cylinder, label=<<font point-size="34">Redis</font><br /><font point-size="19">[Container: Redis 8.6 (Sentinel HA: 1 master / 2 replicas / 3 sentinels)]</font><br /><br /><font point-size="24">Cache + idempotency store<br />(Sentinel HA)</font>>, style=filled, color="#a1352a", fillcolor="#e74c3c", fontcolor="#ffffff"]
    11 [id=11,shape=rect, label=<<font point-size="34">ActiveMQ Artemis</font><br /><font point-size="19">[Container: ActiveMQ Artemis 2.43 (Jakarta JMS)]</font><br /><br /><font point-size="24">Primary FCB request/reply<br />corridor broker</font>>, style=filled, color="#ab7418", fillcolor="#f5a623", fontcolor="#000000"]
    7 [id=7,shape=rect, label=<<font point-size="34">Trade Loan<br />Application</font><br /><font point-size="19">[Container: Java 25, Spring Boot 4]</font><br /><br /><font point-size="24">Spring Boot hexagonal<br />application (driving + driven<br />adapters)</font>>, style=filled, color="#2e6295", fillcolor="#438dd5", fontcolor="#ffffff"]
    8 [id=8,shape=cylinder, label=<<font point-size="34">PostgreSQL Database</font><br /><font point-size="19">[Container: PostgreSQL 18]</font><br /><br /><font point-size="24">Loan data, inbox/outbox,<br />workflow state, audit,<br />reconciliation</font>>, style=filled, color="#2e6295", fillcolor="#438dd5", fontcolor="#ffffff"]
    9 [id=9,shape=rect, label=<<font point-size="34">Kafka</font><br /><font point-size="19">[Container: Apache Kafka (SASL_PLAINTEXT/SCRAM-SHA-256)]</font><br /><br /><font point-size="24">Event streaming +<br />request/reply fallback<br />transport</font>>, style=filled, color="#ab7418", fillcolor="#f5a623", fontcolor="#000000"]
  }

  7 -> 8 [id=12, label=<<font point-size="24">Aggregates, inbox/outbox,<br />workflow, audit,<br />reconciliation</font><br /><font point-size="19">[JDBC/HikariCP]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 10 [id=13, label=<<font point-size="24">Query cache, idempotency,<br />JWKS/token cache</font><br /><font point-size="19">[RESP3 (Sentinel)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 9 [id=14, label=<<font point-size="24">Domain events (outbox) +<br />request/reply fallback</font><br /><font point-size="19">[Kafka (SASL/SCRAM)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 11 [id=15, label=<<font point-size="24">FCB request/reply corridor<br />(primary)</font><br /><font point-size="19">[Jakarta JMS]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 5 [id=16, label=<<font point-size="24">Loads runtime config</font><br /><font point-size="19">[Consul KV (watch / @RefreshScope)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  1 -> 7 [id=176, label=<<font point-size="24">Business loan-lifecycle<br />requests</font><br /><font point-size="19">[REST (SWA-101) / JWT]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 8 [id=179, label=<<font point-size="24">Reads/Writes</font><br /><font point-size="19">[JDBC/HikariCP]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 2 [id=18, label=<<font point-size="24">Validates JWT / fetches<br />JWKS</font><br /><font point-size="19">[OAuth2/OIDC + JWKS]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 9 [id=188, label=<<font point-size="24">Publishes events</font><br /><font point-size="19">[Kafka (SASL/SCRAM)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 9 [id=193, label=<<font point-size="24">Consumes from</font><br /><font point-size="19">[Kafka (SASL/SCRAM)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 3 [id=195, label=<<font point-size="24">Calls (corridor)</font><br /><font point-size="19">[Corridor (Artemis primary / Kafka fallback)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 11 [id=198, label=<<font point-size="24">Request/reply (primary)</font><br /><font point-size="19">[Jakarta JMS]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 3 [id=20, label=<<font point-size="24">Core banking operations<br />via corridor</font><br /><font point-size="19">[Corridor (Artemis primary / Kafka fallback)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 9 [id=202, label=<<font point-size="24">Request/reply (fallback)</font><br /><font point-size="19">[Kafka (SASL/SCRAM)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 8 [id=206, label=<<font point-size="24">Reads reconciliation state</font><br /><font point-size="19">[JDBC/HikariCP]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 3 [id=208, label=<<font point-size="24">Probes / converges</font><br /><font point-size="19">[Corridor (Artemis primary / Kafka fallback)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 4 [id=22, label=<<font point-size="24">Exports traces / metrics /<br />logs</font><br /><font point-size="19">[OTLP http/protobuf]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 3 [id=243, label=<<font point-size="24">Calls</font><br /><font point-size="19">[Corridor (Artemis primary / Kafka fallback)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  24 -> 7 [id=25, label=<<font point-size="24">Operates via OPS endpoints<br />(/v1/ops/*) and MCP ops<br />tools</font><br /><font point-size="19">[HTTPS / JWT (sub-claim allowlist)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 8 [id=251, label=<<font point-size="24">Persists</font><br /><font point-size="19">[JDBC/HikariCP]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 9 [id=253, label=<<font point-size="24">Emits events (outbox)</font><br /><font point-size="19">[Kafka (SASL/SCRAM)]</font>>, style="dashed", color="#707070", fontcolor="#707070"]
  7 -> 8 [id=255, label=<<font point-size="24">Durable workflow state<br />(workflow_run,<br />workflow_compensation)</font><br /><font point-size="19">[JDBC/HikariCP]</font>>, style="dashed", color="#707070", fontcolor="#707070"]

}