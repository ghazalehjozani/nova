@startuml
title <size:24>Component View: Trade Loan Service - Trade Loan Application</size>\n<size:24>CQRS Query flow</size>

set separator none
left to right direction
skinparam ranksep 80
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component,Controller
  .Element-RWxlbWVudCxDb21wb25lbnQsQ29udHJvbGxlcg== {
    BackgroundColor: #7cb342;
    LineColor: #567d2e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Component,Handler
  .Element-RWxlbWVudCxDb21wb25lbnQsSGFuZGxlcg== {
    BackgroundColor: #42a5f5;
    LineColor: #2e73ab;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Trade Loan Application
  .Boundary-VHJhZGUgTG9hbiBBcHBsaWNhdGlvbg== {
    BackgroundColor: #ffffff;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Trade Loan Service
  .Boundary-VHJhZGUgTG9hbiBTZXJ2aWNl {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

