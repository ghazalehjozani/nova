TradeLoanService.TradeLoanApplication.TradeLoanFacilityOutboxHandler .[#707070,thickness=2].> TradeLoanService.Kafka : "<color:#707070>Publishes events\n<color:#707070><size:8>[Kafka Protocol]</size>"
TradeLoanService.TradeLoanApplication.TradeLoanTypeOutboxHandler .[#707070,thickness=2].> TradeLoanService.Kafka : "<color:#707070>Publishes events\n<color:#707070><size:8>[Kafka Protocol]</size>"
