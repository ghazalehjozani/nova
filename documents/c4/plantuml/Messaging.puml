  BackgroundColor #ff7043
  FontColor #ffffff
  BorderColor #b24e2e
  shadowing false
}
skinparam hexagon<<TradeLoanService.TradeLoanApplication.InstallmentScheduleOutboxHandler>> {
  BackgroundColor #66bb6a
  FontColor #000000
  BorderColor #47824a
  shadowing false
}
skinparam queue<<TradeLoanService.Kafka>> {
  BackgroundColor #f5a623
  FontColor #000000
  BorderColor #ab7418
  shadowing false
}
skinparam hexagon<<TradeLoanService.TradeLoanApplication.TradeLoanArrangementOutboxHandler>> {
  BackgroundColor #66bb6a
  FontColor #000000
  BorderColor #47824a
  shadowing false
}
skinparam hexagon<<TradeLoanService.TradeLoanApplication.TradeLoanCommandConsumer>> {
  BackgroundColor #ff7043
  FontColor #ffffff
  BorderColor #b24e2e
  shadowing false
}
skinparam hexagon<<TradeLoanService.TradeLoanApplication.TradeLoanFacilityOutboxHandler>> {
  BackgroundColor #66bb6a
  FontColor #000000
  BorderColor #47824a
  shadowing false
}
