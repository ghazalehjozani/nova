@startuml
title <size:24>Component View: Trade Loan Service - Trade Loan Application</size>\n<size:24>Kafka consumers and outbox handlers</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component,Consumer
  .Element-RWxlbWVudCxDb21wb25lbnQsQ29uc3VtZXI= {
    BackgroundColor: #ff7043;
    LineColor: #b24e2e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Component,Outbox
  .Element-RWxlbWVudCxDb21wb25lbnQsT3V0Ym94 {
    BackgroundColor: #66bb6a;
    LineColor: #47824a;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #000000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Message Broker
  .Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnZSBCcm9rZXI= {
    BackgroundColor: #f5a623;
    LineColor: #ab7418;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #000000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #707070;
    FontColor: #707070;
    FontSize: 24;
  }
  // Trade Loan Application
  .Boundary-VHJhZGUgTG9hbiBBcHBsaWNhdGlvbg== {
    BackgroundColor: #ffffff;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Trade Loan Service
  .Boundary-VHJhZGUgTG9hbiBTZXJ2aWNl {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Trade Loan Service\n<size:16>[Software System]</size>" <<Boundary-VHJhZGUgTG9hbiBTZXJ2aWNl>> {
  rectangle "Trade Loan Application\n<size:16>[Container: Java 25, Spring Boot 4]</size>" <<Boundary-VHJhZGUgTG9hbiBBcHBsaWNhdGlvbg==>> {
    hexagon "==Trade Loan Arrangement Outbox Handler\n<size:16>[Component: Outbox Publisher]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQsT3V0Ym94>> as TradeLoanService.TradeLoanApplication.TradeLoanArrangementOutboxHandler
    hexagon "==Installment Schedule Outbox Handler\n<size:16>[Component: Outbox Publisher]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQsT3V0Ym94>> as TradeLoanService.TradeLoanApplication.InstallmentScheduleOutboxHandler
    hexagon "==Trade Loan Type Outbox Handler\n<size:16>[Component: Outbox Publisher]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQsT3V0Ym94>> as TradeLoanService.TradeLoanApplication.TradeLoanTypeOutboxHandler
    hexagon "==Trade Loan Facility Outbox Handler\n<size:16>[Component: Outbox Publisher]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQsT3V0Ym94>> as TradeLoanService.TradeLoanApplication.TradeLoanFacilityOutboxHandler
    hexagon "==Fcb Event Consumer\n<size:16>[Component: Spring Kafka Listener]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQsQ29uc3VtZXI=>> as TradeLoanService.TradeLoanApplication.FcbEventConsumer
  }

  queue "==ActiveMQ Artemis\n<size:16>[Container: ActiveMQ Artemis 2.43 (Jakarta JMS)]</size>\n\nPrimary FCB request/reply corridor broker" <<Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnZSBCcm9rZXI=>> as TradeLoanService.ActiveMQArtemis
  queue "==Kafka\n<size:16>[Container: Apache Kafka (SASL_PLAINTEXT/SCRAM-SHA-256)]</size>\n\nEvent streaming + request/reply fallback transport" <<Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnZSBCcm9rZXI=>> as TradeLoanService.Kafka
}

TradeLoanService.TradeLoanApplication.TradeLoanArrangementOutboxHandler --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes events\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication.InstallmentScheduleOutboxHandler --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes events\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication.TradeLoanTypeOutboxHandler --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes events\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication.TradeLoanFacilityOutboxHandler --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes events\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication.FcbEventConsumer --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Consumes from\n<size:16>[Kafka (SASL/SCRAM)]</size>"

@enduml