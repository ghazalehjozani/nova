TradeLoanService .[#707070,thickness=2].> CustomerService : "<color:#707070>Calls\n<color:#707070><size:8>[HTTP/REST]</size>"
TradeLoanService .[#707070,thickness=2].> DepositService : "<color:#707070>Calls\n<color:#707070><size:8>[HTTP/REST]</size>"
