rectangle "==ESB\n<size:16>[Software System]</size>\n\nEnterprise Service Bus — routes business loan-lifecycle requests from upstream channels" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVt>> as ESB
rectangle "==TPS SSO\n<size:16>[Software System]</size>\n\nOAuth2/OIDC identity provider (token validation + JWKS)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVtLFNlY3VyaXR5>> as TPSSSO
rectangle "==FCB Core Banking\n<size:16>[Software System]</size>\n\nLegacy core banking — accounts, postings, collateral, sanctions" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVtLENvcmUgQmFua2luZw==>> as FCBCoreBanking
rectangle "==OpenTelemetry Collector\n<size:16>[Software System]</size>\n\nOpenTelemetry collector — traces, metrics, logs" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVtLE9ic2VydmFiaWxpdHk=>> as OpenTelemetryCollector
rectangle "==Consul\n<size:16>[Software System]</size>\n\nRuntime configuration store (Consul KV, fed by GitOps)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVtLENvbmZpZw==>> as Consul
person "==Operator / Admin\n<size:16>[Person]</size>\n\nBank operations / administrator — monitors and remediates the service" <<Element-RWxlbWVudCxQZXJzb24sQWRtaW4=>> as OperatorAdmin

rectangle "Trade Loan Service\n<size:16>[Software System]</size>" <<Boundary-VHJhZGUgTG9hbiBTZXJ2aWNl>> {
  database "==Redis\n<size:16>[Container: Redis 8.6 (Sentinel HA: 1 master / 2 replicas / 3 sentinels)]</size>\n\nCache + idempotency store (Sentinel HA)" <<Element-RWxlbWVudCxDb250YWluZXIsQ2FjaGU=>> as TradeLoanService.Redis
  queue "==ActiveMQ Artemis\n<size:16>[Container: ActiveMQ Artemis 2.43 (Jakarta JMS)]</size>\n\nPrimary FCB request/reply corridor broker" <<Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnZSBCcm9rZXI=>> as TradeLoanService.ActiveMQArtemis
  rectangle "==Trade Loan Application\n<size:16>[Container: Java 25, Spring Boot 4]</size>\n\nSpring Boot hexagonal application (driving + driven adapters)" <<Element-RWxlbWVudCxDb250YWluZXI=>> as TradeLoanService.TradeLoanApplication
  database "==PostgreSQL Database\n<size:16>[Container: PostgreSQL 18]</size>\n\nLoan data, inbox/outbox, workflow state, audit, reconciliation" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as TradeLoanService.PostgreSQLDatabase
  queue "==Kafka\n<size:16>[Container: Apache Kafka (SASL_PLAINTEXT/SCRAM-SHA-256)]</size>\n\nEvent streaming + request/reply fallback transport" <<Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnZSBCcm9rZXI=>> as TradeLoanService.Kafka
}

TradeLoanService.TradeLoanApplication --> TradeLoanService.PostgreSQLDatabase <<Relationship-UmVsYXRpb25zaGlw>> : "Aggregates, inbox/outbox, workflow, audit, reconciliation\n<size:16>[JDBC/HikariCP]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.Redis <<Relationship-UmVsYXRpb25zaGlw>> : "Query cache, idempotency, JWKS/token cache\n<size:16>[RESP3 (Sentinel)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Domain events (outbox) + request/reply fallback\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.ActiveMQArtemis <<Relationship-UmVsYXRpb25zaGlw>> : "FCB request/reply corridor (primary)\n<size:16>[Jakarta JMS]</size>"
TradeLoanService.TradeLoanApplication --> Consul <<Relationship-UmVsYXRpb25zaGlw>> : "Loads runtime config\n<size:16>[Consul KV (watch / @RefreshScope)]</size>"
ESB --> TradeLoanService.TradeLoanApplication <<Relationship-UmVsYXRpb25zaGlw>> : "Business loan-lifecycle requests\n<size:16>[REST (SWA-101) / JWT]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.PostgreSQLDatabase <<Relationship-UmVsYXRpb25zaGlw>> : "Reads/Writes\n<size:16>[JDBC/HikariCP]</size>"
TradeLoanService.TradeLoanApplication --> TPSSSO <<Relationship-UmVsYXRpb25zaGlw>> : "Validates JWT / fetches JWKS\n<size:16>[OAuth2/OIDC + JWKS]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes events\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Consumes from\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication --> FCBCoreBanking <<Relationship-UmVsYXRpb25zaGlw>> : "Calls (corridor)\n<size:16>[Corridor (Artemis primary / Kafka fallback)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.ActiveMQArtemis <<Relationship-UmVsYXRpb25zaGlw>> : "Request/reply (primary)\n<size:16>[Jakarta JMS]</size>"
TradeLoanService.TradeLoanApplication --> FCBCoreBanking <<Relationship-UmVsYXRpb25zaGlw>> : "Core banking operations via corridor\n<size:16>[Corridor (Artemis primary / Kafka fallback)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Request/reply (fallback)\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.PostgreSQLDatabase <<Relationship-UmVsYXRpb25zaGlw>> : "Reads reconciliation state\n<size:16>[JDBC/HikariCP]</size>"
TradeLoanService.TradeLoanApplication --> FCBCoreBanking <<Relationship-UmVsYXRpb25zaGlw>> : "Probes / converges\n<size:16>[Corridor (Artemis primary / Kafka fallback)]</size>"
TradeLoanService.TradeLoanApplication --> OpenTelemetryCollector <<Relationship-UmVsYXRpb25zaGlw>> : "Exports traces / metrics / logs\n<size:16>[OTLP http/protobuf]</size>"
TradeLoanService.TradeLoanApplication --> FCBCoreBanking <<Relationship-UmVsYXRpb25zaGlw>> : "Calls\n<size:16>[Corridor (Artemis primary / Kafka fallback)]</size>"
OperatorAdmin --> TradeLoanService.TradeLoanApplication <<Relationship-UmVsYXRpb25zaGlw>> : "Operates via OPS endpoints (/v1/ops/*) and MCP ops tools\n<size:16>[HTTPS / JWT (sub-claim allowlist)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.PostgreSQLDatabase <<Relationship-UmVsYXRpb25zaGlw>> : "Persists\n<size:16>[JDBC/HikariCP]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "Emits events (outbox)\n<size:16>[Kafka (SASL/SCRAM)]</size>"
TradeLoanService.TradeLoanApplication --> TradeLoanService.PostgreSQLDatabase <<Relationship-UmVsYXRpb25zaGlw>> : "Durable workflow state (workflow_run, workflow_compensation)\n<size:16>[JDBC/HikariCP]</size>"

@enduml