<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>trade-loan</artifactId>
        <version>${revision}</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>architecture-docs</artifactId>
    <description>C4 Architecture documentation generator using Structurizr</description>
    <packaging>jar</packaging>

    <properties>
        <structurizr.version>5.0.3</structurizr.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-core</artifactId>
            <version>${structurizr.version}</version>
        </dependency>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-dsl</artifactId>
            <version>${structurizr.version}</version>
        </dependency>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-export</artifactId>
            <version>${structurizr.version}</version>
        </dependency>
        <!-- Official automatic component discovery (replaces the hand-rolled ClassGraph scanner) -->
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-component</artifactId>
            <version>${structurizr.version}</version>
        </dependency>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-annotation</artifactId>
            <version>${structurizr.version}</version>
        </dependency>

        <!--
          ALL trade-loan modules whose bytecode must be discoverable - default (compile) scope.
          test scope hides the classes from structurizr-component and the scan silently yields 0.
          When a new sibling adapter module is added to the build, ADD IT HERE too.
        -->
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driving-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driving-messaging-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driving-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-query</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-reconciliation</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-ports-inbound</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-ports-outbound</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-c4</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>ir.dotin.loan.trade.architecture.ArchitectureGenerator</mainClass>
                            <arguments>
                                <argument>${project.basedir}/../</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
