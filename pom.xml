<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ir.dotin.loan</groupId>
    <artifactId>loan-parent</artifactId>
    <version>0.0.2-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <artifactId>morabehe-loan</artifactId>
  <name>Morabehe Loan</name>
  <packaging>pom</packaging>

  <modules>
    <module>core</module>
    <module>adapters</module>
    <module>container</module>
  </modules>

  <properties>
    <sonar.projectKey>ir.dotin.loan:morabehe-loan</sonar.projectKey>
    <sonar.projectName>Morabehe Loan</sonar.projectName>
    <sonar.projectVersion>${project.version}</sonar.projectVersion>
    <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
    <sonar.language>java</sonar.language>
    <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
    <sonar.sources>src</sonar.sources>
    <sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
    <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
    <sonar.sources>src/main</sonar.sources>
    <sonar.tests>src/test/java</sonar.tests>
    <sonar.binaries>target/classes</sonar.binaries>
    <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>morabehe-loan-core-domain</artifactId>
        <version>${project.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>morabehe-loan-core-application-ports</artifactId>
        <version>${project.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>morabehe-loan-core-application-service</artifactId>
        <version>${project.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>morabehe-loan-adapters-driven-persistence</artifactId>
        <version>${project.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>morabehe-loan-adapters-driving-web</artifactId>
        <version>${project.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>morabehe-loan-adapters-driven-client</artifactId>
        <version>${project.version}</version>
        <scope>compile</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
