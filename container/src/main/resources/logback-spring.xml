<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds" debug="false">

    <!-- =========================================== -->
    <!-- PROPERTY DEFINITIONS                        -->
    <!-- =========================================== -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="trade-loan-service"/>
    <springProperty scope="context" name="APP_VERSION" source="spring.application.version" defaultValue="unknown"/>
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <property name="HOSTNAME" value="${HOSTNAME:-localhost}"/>
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <!-- =========================================== -->
    <!-- CONSOLE PATTERNS                            -->
    <!-- =========================================== -->

    <!-- Colorful pattern for development -->
    <property name="DEV_CONSOLE_PATTERN"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5p){bold,highlight} %clr([%X{traceId:--},%X{spanId:--}]){cyan} %clr(%-40.40logger{39}){blue} %clr(:){faint} %m%n%clr(%wEx){red}"/>

    <!-- Standard pattern for non-dev -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{40} - %msg%n%ex"/>

    <!-- File pattern with comprehensive MDC -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [trace=%X{traceId:-},span=%X{spanId:-},user=%X{userId:-},corr=%X{correlationId:-},tenant=%X{tenantId:-},session=%X{sessionId:-}] %logger{40} - %msg%n%ex"/>

    <!-- =========================================== -->
    <!-- JSON PATTERN (ECS Compatible)               -->
    <!-- =========================================== -->
    <property name="JSON_PATTERN" value='{"@timestamp":"%d{yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSXXX}","log.level":"%level","process.thread.name":"%thread","service.name":"${APP_NAME}","service.version":"${APP_VERSION}","host.hostname":"${HOSTNAME}","log.logger":"%logger","trace.id":"%X{traceId:-}","span.id":"%X{spanId:-}","user.id":"%X{userId:-}","correlation.id":"%X{correlationId:-}","tenant.id":"%X{tenantId:-}","session.id":"%X{sessionId:-}","message":"%replace(%msg){&apos;\"&apos;,&apos;\\\"&apos;}","stack_trace":"%replace(%ex{full}){&apos;\"&apos;,&apos;\\\"&apos;}","labels":%X{labels:-\{\}}}%n'/>

    <!-- =========================================== -->
    <!-- CONSOLE APPENDER                            -->
    <!-- =========================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DEV_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${DEV_CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- =========================================== -->
    <!-- FILE APPENDERS                              -->
    <!-- =========================================== -->

    <!-- Application Log -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>20GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- Error Log -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- JSON Structured Log -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-json.log</file>
        <encoder>
            <pattern>${JSON_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-json-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Audit Log (separate retention policy) -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-audit.log</file>
        <encoder>
            <pattern>${JSON_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-audit-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>500MB</maxFileSize>
            <maxHistory>365</maxHistory>
            <totalSizeCap>50GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Performance Metrics Log -->
    <appender name="PERF_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-performance.log</file>
        <encoder>
            <pattern>${JSON_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-performance-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- =========================================== -->
    <!-- ASYNC APPENDERS                             -->
    <!-- =========================================== -->

    <appender name="ASYNC_APP" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="APP_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <maxFlushTime>5000</maxFlushTime>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ERROR_FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
        <neverBlock>false</neverBlock>
        <maxFlushTime>10000</maxFlushTime>
    </appender>

    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <maxFlushTime>5000</maxFlushTime>
    </appender>

    <appender name="ASYNC_AUDIT" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="AUDIT_FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
        <neverBlock>false</neverBlock>
        <maxFlushTime>15000</maxFlushTime>
    </appender>

    <!-- =========================================== -->
    <!-- SPECIAL LOGGERS                             -->
    <!-- =========================================== -->

    <!-- Audit Logger (additive=false, separate channel) -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_AUDIT"/>
    </logger>

    <!-- Performance Logger -->
    <logger name="PERFORMANCE" level="INFO" additivity="false">
        <appender-ref ref="PERF_FILE"/>
    </logger>

    <!-- =========================================== -->
    <!-- FRAMEWORK LOGGERS                           -->
    <!-- =========================================== -->

    <!-- Platform/Domain Loggers -->
    <logger name="ir.dotin.platform" level="INFO"/>
    <logger name="ir.dotin.loan" level="INFO"/>

    <!-- Spring Framework -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.springframework.transaction" level="INFO"/>
    <logger name="org.springframework.orm.jpa" level="INFO"/>
    <logger name="org.springframework.cloud.kubernetes" level="INFO"/>

    <!-- Hibernate/JPA -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="INFO"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.hibernate.engine.transaction" level="WARN"/>

    <!-- Connection Pool -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="com.zaxxer.hikari.HikariConfig" level="WARN"/>

    <!-- Kafka -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.apache.kafka.clients.consumer.internals" level="ERROR"/>
    <logger name="org.apache.kafka.clients.producer.internals" level="ERROR"/>

    <!-- Database Drivers -->
    <logger name="org.postgresql" level="WARN"/>

    <!-- Observability -->
    <logger name="io.opentelemetry" level="INFO"/>
    <logger name="io.micrometer" level="INFO"/>
    <logger name="io.micrometer.core.instrument" level="WARN"/>
    <logger name="io.jaegertracing" level="WARN"/>

    <!-- =========================================== -->
    <!-- PROFILE: DEVELOPMENT (Local)                -->
    <!-- =========================================== -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="DEV_CONSOLE"/>
            <appender-ref ref="ASYNC_APP"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>

        <!-- Enhanced debug levels for dev -->
        <logger name="ir.dotin" level="DEBUG"/>
        <logger name="ir.dotin.loan.trade.adapters.driven.fcbclient.service" level="DEBUG"/>
        <logger name="SECURITY_AUDIT" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
        <logger name="org.springframework.security.oauth2" level="TRACE"/>
        <logger name="org.hibernate.SQL" level="INFO"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
        <logger name="org.springframework.kafka" level="INFO"/>
        <logger name="org.springframework.transaction" level="DEBUG"/>
    </springProfile>

    <!-- =========================================== -->
    <!-- PROFILE: KUBERNETES (Stage/Production)      -->
    <!-- =========================================== -->
    <springProfile name="k8s">
        <!-- JSON to stdout for container log aggregation -->
        <appender name="K8S_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${JSON_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="ASYNC_K8S_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="K8S_CONSOLE"/>
            <queueSize>2048</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
            <neverBlock>true</neverBlock>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_K8S_CONSOLE"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>

        <!-- Production log levels -->
        <logger name="ir.dotin.platform" level="INFO"/>
        <logger name="ir.dotin.loan" level="INFO"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.cloud.kubernetes" level="INFO"/>
        <logger name="org.springframework.kafka" level="WARN"/>

        <logger name="org.apache.kafka.clients" level="ERROR"/>
    </springProfile>

</configuration>
