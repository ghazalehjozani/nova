<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        All-or-nothing saga migration: the SUSPENDED state has been removed from the engine. Any leftover
        rows in SUSPENDED (parked under the retired STOP_ON_STEP strategy) would fail EnumType.STRING loading
        once the enum value is gone, so they are purged here. Compensation rows are removed first (no DB-level
        FK, so deleted by sub-select on saga_id). Deletes are irreversible — empty rollback.
    -->

    <changeSet id="fw-1.0.0-010-delete-suspended-sagas" author="DOTIN\m.amirabdollahi">
        <comment>Purge leftover SUSPENDED sagas after suspend-on-step removal (all-or-nothing sagas)</comment>
        <sql>
            DELETE FROM saga_compensation
            WHERE saga_id IN (SELECT id FROM saga_instance WHERE current_state = 'SUSPENDED');
        </sql>
        <sql>
            DELETE FROM saga_instance WHERE current_state = 'SUSPENDED';
        </sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
