<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        Add the originating W3C trace context (traceparent + tracestate) to all four outbox event tables.
        Captured on the business-transaction thread at publish time so the relay poller can re-attach the
        published Kafka record to its originating trace instead of starting a new one. Always nullable —
        rows written before this rollout, or outside any active span, simply carry no trace context.
    -->

    <changeSet id="tl-1.0.0-105-add-traceparent-arrangement" author="DOTIN\m.amirabdollahi">
        <comment>Trace context columns on loan_arrangement_outbox_events</comment>
        <addColumn tableName="loan_arrangement_outbox_events">
            <column name="traceparent" type="VARCHAR(64)"/>
            <column name="tracestate" type="VARCHAR(512)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="traceparent"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="tracestate"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-106-add-traceparent-facility" author="DOTIN\m.amirabdollahi">
        <comment>Trace context columns on loan_facility_outbox_events</comment>
        <addColumn tableName="loan_facility_outbox_events">
            <column name="traceparent" type="VARCHAR(64)"/>
            <column name="tracestate" type="VARCHAR(512)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="loan_facility_outbox_events" columnName="traceparent"/>
            <dropColumn tableName="loan_facility_outbox_events" columnName="tracestate"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-107-add-traceparent-loan-type" author="DOTIN\m.amirabdollahi">
        <comment>Trace context columns on loan_type_outbox_events</comment>
        <addColumn tableName="loan_type_outbox_events">
            <column name="traceparent" type="VARCHAR(64)"/>
            <column name="tracestate" type="VARCHAR(512)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="loan_type_outbox_events" columnName="traceparent"/>
            <dropColumn tableName="loan_type_outbox_events" columnName="tracestate"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-108-add-traceparent-installment" author="DOTIN\m.amirabdollahi">
        <comment>Trace context columns on installment_schedule_outbox_events</comment>
        <addColumn tableName="installment_schedule_outbox_events">
            <column name="traceparent" type="VARCHAR(64)"/>
            <column name="tracestate" type="VARCHAR(512)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="installment_schedule_outbox_events" columnName="traceparent"/>
            <dropColumn tableName="installment_schedule_outbox_events" columnName="tracestate"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
