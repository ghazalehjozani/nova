<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        Add actor envelope columns (initiator, accountability, execution provenance)
        to all four outbox event tables. Nullable during rollout window so existing
        rows continue to flush; flip to NOT NULL after backfill (separate changeset).
        See ADR-0003 + brief §2.3.
    -->

    <changeSet id="tl-1.0.0-101-add-actor-cols-arrangement" author="DOTIN\m.amirabdollahi">
        <comment>Actor envelope columns on loan_arrangement_outbox_events</comment>
        <addColumn tableName="loan_arrangement_outbox_events">
            <column name="initiator_sub" type="VARCHAR(128)"/>
            <column name="initiator_type" type="VARCHAR(32)"/>
            <column name="initiator_branch_code" type="VARCHAR(16)"/>
            <column name="initiator_source" type="VARCHAR(32)"/>
            <column name="accountability_sub" type="VARCHAR(128)"/>
            <column name="accountability_type" type="VARCHAR(32)"/>
            <column name="execution_trigger" type="VARCHAR(32)"/>
            <column name="execution_mode" type="VARCHAR(8)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="initiator_sub"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="initiator_type"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="initiator_branch_code"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="initiator_source"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="accountability_sub"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="accountability_type"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="execution_trigger"/>
            <dropColumn tableName="loan_arrangement_outbox_events" columnName="execution_mode"/>
        </rollback>
    </changeSet>

