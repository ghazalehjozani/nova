<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- ===== sanctioned_loans ===== -->

    <changeSet id="tl-1.0.0-021-create-sanctioned-loans" author="DOTIN\m.amirabdollahi">
        <comment>Approved/sanctioned loan records with amount, duration, and disbursement schedule link</comment>
        <createTable tableName="sanctioned_loans">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_sanctioned_loans"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="life_insurance_id" type="VARCHAR(255)"/>
            <column name="disbursement_schedule_id" type="UUID"/>
            <column name="disbursement_method" type="VARCHAR(255)"/>
            <column name="sanction_serial_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sanction_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="approved_amount" type="DECIMAL(19, 4)"/>
            <column name="approved_currency" type="VARCHAR(3)"/>
            <column name="currency" type="VARCHAR(255)"/>
            <column name="grace_period_days" type="INT"/>
            <column name="grace_period_months" type="INT"/>
            <column name="grace_period_years" type="INT"/>
            <column name="installment_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_duration_years" type="INT"/>
            <column name="loan_duration_months" type="INT"/>
            <column name="loan_duration_days" type="INT"/>
            <column name="revocation_reason" type="TEXT"/>
            <column name="confirm_person_code" type="VARCHAR(255)"/>
        </createTable>
        <rollback>
            <dropTable tableName="sanctioned_loans"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-022-uc-sanctioned-loan-serial" author="DOTIN\m.amirabdollahi">
        <comment>Enforce unique sanction serial across all sanctioned loans</comment>
        <addUniqueConstraint columnNames="sanction_serial_value"
                             constraintName="uc_sanctioned_loans_serial"
                             tableName="sanctioned_loans"/>
        <rollback>
            <dropUniqueConstraint tableName="sanctioned_loans" constraintName="uc_sanctioned_loans_serial"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-023-uc-sanctioned-loan-disbursement-schedule" author="DOTIN\m.amirabdollahi">
        <comment>Each sanctioned loan has at most one disbursement schedule</comment>
        <addUniqueConstraint columnNames="disbursement_schedule_id"
                             constraintName="uc_sanctioned_loans_disbursement_schedule"
                             tableName="sanctioned_loans"/>
        <rollback>
            <dropUniqueConstraint tableName="sanctioned_loans"
                                  constraintName="uc_sanctioned_loans_disbursement_schedule"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
