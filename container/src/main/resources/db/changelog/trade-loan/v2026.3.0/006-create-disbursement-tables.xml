<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- ===== loan_disbursement_schedules ===== -->

    <changeSet id="tl-1.0.0-037-create-disbursement-schedules" author="DOTIN\m.amirabdollahi">
        <comment>Parent entity for planned disbursement tranches</comment>
        <createTable tableName="loan_disbursement_schedules">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_disbursement_schedules"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
        </createTable>
        <rollback>
            <dropTable tableName="loan_disbursement_schedules"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-038-fk-sanctioned-loan-to-disbursement-schedule" author="DOTIN\m.amirabdollahi">
        <comment>FK from sanctioned_loans to their disbursement schedule</comment>
        <addForeignKeyConstraint baseColumnNames="disbursement_schedule_id"
                                 baseTableName="sanctioned_loans"
                                 constraintName="fk_sanctioned_loans_on_disbursement_schedule"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_disbursement_schedules"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="sanctioned_loans"
                                      constraintName="fk_sanctioned_loans_on_disbursement_schedule"/>
        </rollback>
    </changeSet>

    <!-- ===== loan_disbursement_schedule_tranches ===== -->

    <changeSet id="tl-1.0.0-039-create-disbursement-tranches" author="DOTIN\m.amirabdollahi">
        <comment>Individual tranches within a disbursement schedule (date + amount)</comment>
        <createTable tableName="loan_disbursement_schedule_tranches">
            <column name="disbursement_schedule_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="scheduled_date" type="DATETIME"/>
            <column name="amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="loan_disbursement_schedule_tranches"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-040-fk-disbursement-tranches" author="DOTIN\m.amirabdollahi">
        <comment>FK from disbursement tranches to their parent schedule</comment>
        <addForeignKeyConstraint baseColumnNames="disbursement_schedule_id"
                                 baseTableName="loan_disbursement_schedule_tranches"
                                 constraintName="fk_disbursement_tranches_on_schedule"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_disbursement_schedules"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_disbursement_schedule_tranches"
                                      constraintName="fk_disbursement_tranches_on_schedule"/>
        </rollback>
    </changeSet>

    <!-- ===== loan_disbursement_records ===== -->

    <changeSet id="tl-1.0.0-041-create-disbursement-records" author="DOTIN\m.amirabdollahi">
        <comment>Actual disbursement records against a sanctioned loan, ordered by sequence</comment>
        <createTable tableName="loan_disbursement_records">
            <column name="sanctioned_loan_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_disbursement_records"/>
            </column>
            <column name="disbursed_amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="disbursed_currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="disbursed_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="disbursed_by" type="VARCHAR(50)"/>
            <column name="record_order" type="INT">
                <constraints primaryKey="true" primaryKeyName="pk_loan_disbursement_records"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="loan_disbursement_records"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-042-fk-disbursement-records" author="DOTIN\m.amirabdollahi">
        <comment>FK from disbursement records to their sanctioned loan</comment>
        <addForeignKeyConstraint baseColumnNames="sanctioned_loan_id"
                                 baseTableName="loan_disbursement_records"
                                 constraintName="fk_disbursement_records_on_sanctioned_loan"
                                 referencedColumnNames="id"
                                 referencedTableName="sanctioned_loans"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_disbursement_records"
                                      constraintName="fk_disbursement_records_on_sanctioned_loan"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
