<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- ===== loan_installment_schedules ===== -->

    <changeSet id="tl-1.0.0-043-create-installment-schedules" author="DOTIN\m.amirabdollahi">
        <comment>Installment schedule definition with interest rate, restructuring data, and grace periods</comment>
        <createTable tableName="loan_installment_schedules">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_installment_schedules"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="loan_facility_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="initiated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="interest_rate" type="DECIMAL(10, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="grace_period_days" type="INT"/>
            <column name="grace_period_months" type="INT"/>
            <column name="grace_period_years" type="INT"/>
            <!-- Restructuring fields -->
            <column name="new_installment_count" type="INT"/>
            <column name="preserved_installments_count" type="INT"/>
            <column name="previous_installment_count" type="INT"/>
            <column name="restructured_at" type="DATETIME"/>
            <column name="restructured_by" type="VARCHAR(50)"/>
            <column name="restructuring_amount" type="DECIMAL(19, 4)"/>
            <column name="restructuring_amount_currency" type="VARCHAR(3)"/>
            <column name="restructuring_reason" type="VARCHAR(500)"/>
            <column name="unpaid_installments_count" type="INT"/>
        </createTable>
        <rollback>
            <dropTable tableName="loan_installment_schedules"/>
        </rollback>
    </changeSet>

    <!-- ===== loan_installment_schedule_history_ids ===== -->

    <changeSet id="tl-1.0.0-044-create-schedule-history" author="DOTIN\m.amirabdollahi">
        <comment>Linked list of schedule versions tracking restructuring history</comment>
        <createTable tableName="loan_installment_schedule_history_ids">
            <column name="current_schedule_id" type="UUID">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="pk_loan_installment_schedule_history_ids"/>
            </column>
            <column name="previous_schedule_id" type="UUID"/>
            <column name="sequence_order" type="INT">
                <constraints primaryKey="true" primaryKeyName="pk_loan_installment_schedule_history_ids"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="loan_installment_schedule_history_ids"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-045-fk-schedule-history" author="DOTIN\m.amirabdollahi">
        <comment>FK from schedule history to its current installment schedule</comment>
        <addForeignKeyConstraint baseColumnNames="current_schedule_id"
                                 baseTableName="loan_installment_schedule_history_ids"
                                 constraintName="fk_schedule_history_on_installment_schedule"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_installment_schedules"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_installment_schedule_history_ids"
                                      constraintName="fk_schedule_history_on_installment_schedule"/>
        </rollback>
    </changeSet>

    <!-- ===== loan_installments ===== -->

    <changeSet id="tl-1.0.0-046-create-loan-installments" author="DOTIN\m.amirabdollahi">
        <comment>Individual installment rows within a schedule, with principal/interest/paid/outstanding amounts</comment>
        <createTable tableName="loan_installments">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_installments"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="sequence_number" type="INT"/>
            <column name="due_date" type="DATE"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="paid_date" type="DATE"/>
            <column name="installment_schedule_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount_currency" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_amount_currency" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="interest_amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="interest_amount_currency" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="paid_amount_amount" type="DECIMAL(19, 4)"/>
            <column name="paid_amount_currency" type="VARCHAR(255)"/>
            <column name="outstanding_amount" type="DECIMAL(19, 4)"/>
            <column name="outstanding_amount_currency" type="VARCHAR(255)"/>
        </createTable>
        <rollback>
            <dropTable tableName="loan_installments"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-047-fk-installments-to-schedule" author="DOTIN\m.amirabdollahi">
        <comment>FK from installments to their parent installment schedule</comment>
        <addForeignKeyConstraint baseColumnNames="installment_schedule_id"
                                 baseTableName="loan_installments"
                                 constraintName="fk_installments_on_schedule"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_installment_schedules"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_installments"
                                      constraintName="fk_installments_on_schedule"/>
        </rollback>
    </changeSet>

    <!-- ===== loan_installment_payments ===== -->

    <changeSet id="tl-1.0.0-048-create-installment-payments" author="DOTIN\m.amirabdollahi">
        <comment>Payment records against individual installments from legacy core banking</comment>
        <createTable tableName="loan_installment_payments">
            <column name="installment_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="payment_reference" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_amount" type="DECIMAL(19, 4)"/>
            <column name="principal_amount_currency" type="VARCHAR(3)"/>
            <column name="interest_amount" type="DECIMAL(19, 4)"/>
            <column name="interest_amount_currency" type="VARCHAR(3)"/>
            <column name="total_paid_amount" type="DECIMAL(19, 4)"/>
            <column name="total_paid_amount_currency" type="VARCHAR(3)"/>
            <column name="value_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="payment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="channel" type="VARCHAR(255)"/>
            <column name="transaction_reference" type="VARCHAR(255)"/>
            <column name="remarks" type="VARCHAR(255)"/>
            <column name="installment_sequence_number" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="loan_installment_payments"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-049-fk-installment-payments" author="DOTIN\m.amirabdollahi">
        <comment>FK from installment payments to their parent installment</comment>
        <addForeignKeyConstraint baseColumnNames="installment_id"
                                 baseTableName="loan_installment_payments"
                                 constraintName="fk_installment_payments_on_installment"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_installments"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_installment_payments"
                                      constraintName="fk_installment_payments_on_installment"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-050-idx-installment-payments" author="DOTIN\m.amirabdollahi">
        <comment>Index for looking up all payments for a given installment</comment>
        <createIndex tableName="loan_installment_payments"
                     indexName="idx_installment_payments_installment_id">
            <column name="installment_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="loan_installment_payments"
                       indexName="idx_installment_payments_installment_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
