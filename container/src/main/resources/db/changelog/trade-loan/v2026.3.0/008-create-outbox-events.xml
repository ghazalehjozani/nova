<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        Transactional Outbox pattern tables for reliable event publishing.
        Four aggregate types share the same schema:
          1. loan_arrangement
          2. loan_facility
          3. loan_type
          4. installment_schedule
    -->

    <!-- ================================================================== -->
    <!-- 1. LOAN ARRANGEMENT OUTBOX                                         -->
    <!-- ================================================================== -->

    <changeSet id="tl-1.0.0-051-create-arrangement-outbox-events" author="DOTIN\m.amirabdollahi">
        <comment>Outbox events for loan arrangement aggregate domain events</comment>
        <createTable tableName="loan_arrangement_outbox_events">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_arrangement_outbox_events"/>
            </column>
            <column name="event_id" type="UUID"><constraints nullable="false"/></column>
            <column name="idempotency_key" type="VARCHAR(255)"/>
            <column name="aggregate_id" type="UUID"><constraints nullable="false"/></column>
            <column name="event_type" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="event_version" type="INT"><constraints nullable="false"/></column>
            <column name="sequence_number" type="BIGINT"><constraints nullable="false"/></column>
            <column name="payload" type="TEXT"><constraints nullable="false"/></column>
            <column name="partition_key" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="target_topic" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="retry_count" type="INT"><constraints nullable="false"/></column>
            <column name="next_retry_at" type="DATETIME"/>
            <column name="error_message" type="VARCHAR(4000)"/>
            <column name="error_stacktrace" type="TEXT"/>
            <column name="aggregate_type" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="processed_at" type="DATETIME"/>
            <column name="locked_at" type="DATETIME"/>
            <column name="locked_by" type="VARCHAR(255)"/>
            <column name="correlation_id" type="UUID"/>
            <column name="causation_id" type="UUID"/>
            <column name="version" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_at" type="DATETIME"><constraints nullable="false"/></column>
            <column name="modified_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
        </createTable>
        <rollback><dropTable tableName="loan_arrangement_outbox_events"/></rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-052-uc-arrangement-outbox" author="DOTIN\m.amirabdollahi">
        <comment>Unique event_id and idempotency_key for arrangement outbox deduplication</comment>
        <addUniqueConstraint columnNames="event_id"
                             constraintName="uc_arrangement_outbox_event_id"
                             tableName="loan_arrangement_outbox_events"/>
        <addUniqueConstraint columnNames="idempotency_key"
                             constraintName="uc_arrangement_outbox_idempotency_key"
                             tableName="loan_arrangement_outbox_events"/>
        <rollback>
            <dropUniqueConstraint tableName="loan_arrangement_outbox_events" constraintName="uc_arrangement_outbox_idempotency_key"/>
            <dropUniqueConstraint tableName="loan_arrangement_outbox_events" constraintName="uc_arrangement_outbox_event_id"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-053-create-arrangement-outbox-metadata" author="DOTIN\m.amirabdollahi">
        <comment>Key-value metadata for arrangement outbox events</comment>
        <createTable tableName="loan_arrangement_outbox_metadata">
            <column name="outbox_event_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_arrangement_outbox_metadata"/>
            </column>
            <column name="meta_value" type="VARCHAR(2000)"/>
            <column name="meta_key" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_arrangement_outbox_metadata"/>
            </column>
        </createTable>
        <rollback><dropTable tableName="loan_arrangement_outbox_metadata"/></rollback>
    </changeSet>

    <changeSet id="tl-1.0.0-054-fk-arrangement-outbox-metadata" author="DOTIN\m.amirabdollahi">
        <comment>FK from arrangement outbox metadata to its parent event</comment>
        <addForeignKeyConstraint baseColumnNames="outbox_event_id"
                                 baseTableName="loan_arrangement_outbox_metadata"
                                 constraintName="fk_arrangement_outbox_metadata_on_event"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_arrangement_outbox_events"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_arrangement_outbox_metadata"
                                      constraintName="fk_arrangement_outbox_metadata_on_event"/>
        </rollback>
    </changeSet>

