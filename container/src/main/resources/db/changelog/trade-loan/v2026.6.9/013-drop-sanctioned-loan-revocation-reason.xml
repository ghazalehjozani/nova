<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        CS-1 (base-loan 2026.6.8 refactor): the RevocationReasonEmb is no longer persisted on sanctioned_loans.
        Drop the orphaned revocation_reason (TEXT) column. There is NO disbursement column on sanctioned_loans to
        drop - disbursement history was always the separate loan_disbursement_records table.
    -->

    <changeSet id="tl-2026.6.9-013-drop-sanctioned-loan-revocation-reason" author="DOTIN\m.amirabdollahi">
        <comment>Drop the RevocationReasonEmb-backed revocation_reason column from sanctioned_loans (no longer mapped)</comment>
        <dropColumn tableName="sanctioned_loans" columnName="revocation_reason"/>
        <rollback>
            <addColumn tableName="sanctioned_loans">
                <column name="revocation_reason" type="TEXT"/>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
