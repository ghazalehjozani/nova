<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        CS-3 (base-loan 2026.6.8 refactor): loan_disbursement_records now hang off the facility, not the sanctioned
        loan. Repoint the table from sanctioned_loan_id to loan_facility_id.

        Backfill is deterministic: loan_facilities.sanctioned_loan_id carries a UNIQUE constraint
        (uc_loan_facilities_sanctioned_loan), so each sanctioned loan maps to at most one facility.

        ORDER MATTERS: add nullable FK column -> backfill -> drop old FK -> drop old PK -> enforce NOT NULL ->
        add new PK -> drop old column -> add new FK.
    -->

    <changeSet id="tl-2026.6.9-015a-add-disbursement-records-facility-column" author="DOTIN\m.amirabdollahi">
        <comment>Add nullable loan_facility_id to loan_disbursement_records ahead of repointing</comment>
        <addColumn tableName="loan_disbursement_records">
            <column name="loan_facility_id" type="UUID"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="loan_disbursement_records" columnName="loan_facility_id"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015b-backfill-disbursement-records-facility" author="DOTIN\m.amirabdollahi">
        <comment>Backfill loan_facility_id from the 1:1 facility of each sanctioned loan</comment>
        <sql>
            UPDATE loan_disbursement_records r
            SET loan_facility_id = (SELECT f.id
                                    FROM loan_facilities f
                                    WHERE f.sanctioned_loan_id = r.sanctioned_loan_id)
            WHERE EXISTS (SELECT 1
                          FROM loan_facilities f
                          WHERE f.sanctioned_loan_id = r.sanctioned_loan_id);
        </sql>
        <rollback>
            <!-- backfill is undone by 015h's rollback which repopulates sanctioned_loan_id; nothing to do here -->
            <empty/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015c-drop-disbursement-records-sanctioned-fk" author="DOTIN\m.amirabdollahi">
        <comment>Drop the old FK to sanctioned_loans</comment>
        <dropForeignKeyConstraint baseTableName="loan_disbursement_records"
                                  constraintName="fk_disbursement_records_on_sanctioned_loan"/>
        <rollback>
            <addForeignKeyConstraint baseColumnNames="sanctioned_loan_id"
                                     baseTableName="loan_disbursement_records"
                                     constraintName="fk_disbursement_records_on_sanctioned_loan"
                                     referencedColumnNames="id"
                                     referencedTableName="sanctioned_loans"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015d-drop-disbursement-records-old-pk" author="DOTIN\m.amirabdollahi">
        <comment>Drop the composite PK (sanctioned_loan_id, record_order)</comment>
        <dropPrimaryKey tableName="loan_disbursement_records" constraintName="pk_loan_disbursement_records"/>
        <rollback>
            <addPrimaryKey tableName="loan_disbursement_records"
                           columnNames="sanctioned_loan_id, record_order"
                           constraintName="pk_loan_disbursement_records"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015e-disbursement-records-facility-not-null" author="DOTIN\m.amirabdollahi">
        <comment>Enforce NOT NULL on loan_facility_id now that it is fully backfilled</comment>
        <addNotNullConstraint tableName="loan_disbursement_records"
                              columnName="loan_facility_id"
                              columnDataType="UUID"/>
        <rollback>
            <dropNotNullConstraint tableName="loan_disbursement_records"
                                   columnName="loan_facility_id"
                                   columnDataType="UUID"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015f-disbursement-records-new-pk" author="DOTIN\m.amirabdollahi">
        <comment>New composite PK (loan_facility_id, record_order)</comment>
        <addPrimaryKey tableName="loan_disbursement_records"
                       columnNames="loan_facility_id, record_order"
                       constraintName="pk_loan_disbursement_records"/>
        <rollback>
            <dropPrimaryKey tableName="loan_disbursement_records" constraintName="pk_loan_disbursement_records"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015g-drop-disbursement-records-sanctioned-column" author="DOTIN\m.amirabdollahi">
        <comment>Drop the now-unused sanctioned_loan_id column</comment>
        <dropColumn tableName="loan_disbursement_records" columnName="sanctioned_loan_id"/>
        <rollback>
            <addColumn tableName="loan_disbursement_records">
                <column name="sanctioned_loan_id" type="UUID"/>
            </addColumn>
            <!-- repopulate from the facility's 1:1 sanctioned loan so the old PK/FK rollbacks can re-apply -->
            <sql>
                UPDATE loan_disbursement_records r
                SET sanctioned_loan_id = (SELECT f.sanctioned_loan_id
                                          FROM loan_facilities f
                                          WHERE f.id = r.loan_facility_id)
                WHERE EXISTS (SELECT 1
                              FROM loan_facilities f
                              WHERE f.id = r.loan_facility_id);
            </sql>
            <addNotNullConstraint tableName="loan_disbursement_records"
                                  columnName="sanctioned_loan_id"
                                  columnDataType="UUID"/>
        </rollback>
    </changeSet>

    <changeSet id="tl-2026.6.9-015h-add-disbursement-records-facility-fk" author="DOTIN\m.amirabdollahi">
        <comment>New FK from disbursement records to loan_facilities</comment>
        <addForeignKeyConstraint baseColumnNames="loan_facility_id"
                                 baseTableName="loan_disbursement_records"
                                 constraintName="fk_disbursement_records_on_facility"
                                 referencedColumnNames="id"
                                 referencedTableName="loan_facilities"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loan_disbursement_records"
                                      constraintName="fk_disbursement_records_on_facility"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
