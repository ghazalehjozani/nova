<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!--
        LN-59405: Remove per-collateral percent column.
        Coverage validation is now money-based (sum of usedAmount >= approvedAmount * totalPercent / 100).
    -->
    <changeSet id="011-drop-collateral-percent-column" author="nova-service">
        <dropColumn tableName="loan_facility_collaterals" columnName="percent"/>
    </changeSet>

</databaseChangeLog>
