    <include file="changes/20260301T000030_create_disbursement_schedules.sql" relativeToChangelogFile="true"/>
    <include file="changes/20260301T000040_create_sanctioned_loans.sql" relativeToChangelogFile="true"/>
    <include file="changes/20260301T000050_create_loan_facilities.sql" relativeToChangelogFile="true"/>

    <!-- Repayment: installment schedules + installments + payments -->
    <include file="changes/20260301T000060_create_installment_schedules.sql" relativeToChangelogFile="true"/>

    <!-- Transactional outbox (one table per aggregate type) -->
