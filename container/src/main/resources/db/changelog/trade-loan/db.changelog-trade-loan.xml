<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        logicalFilePath="trade-loan/db.changelog-trade-loan.xml">

    <!--
        Trade-loan domain changelog: INCLUDES ONLY (thin master). EXPLICIT, ordered includes of the formatted-SQL
        leaves under changes/. ONE changeSet per leaf. This is a GREENFIELD baseline: every leaf translates the
        CURRENT end-state schema the JPA entities under adapters/driven/persistence validate against. All historical
        add-column / alter / repoint / retype migrations are FOLDED into the create-leaf for the table they touched:
          * actor-envelope (8 cols) + W3C traceparent/tracestate -> folded into each outbox-events create.
          * close-paid-off + cancellation columns + effective_loan_duration (PeriodEmb) -> folded into loan_facilities.
          * loan_disbursement_records created already keyed on (loan_facility_id, record_order) (the base-loan 6.8
            repoint end state), FK to loan_facilities, no sanctioned_loan_id.
          * loan_facility_restructuring_transaction_numbers created with the 4 TransactionNumberEmb columns + index
            (the base-loan 6.8 retype end state); the legacy single-String tatweel column never exists.
          * sanctioned_loans created WITHOUT revocation_reason (dropped in base-loan 6.8); loan_facility_collaterals
            created WITHOUT percent (money-based coverage, LN-59405).
        The retired saga_* tables are NEVER created (saga->workflow, LN-59501), so no drop/delete changeset exists.

        FUTURE OPTION (not applied here): the largest append-only event tables — the four *_outbox_events tables —
        are candidates for native PostgreSQL RANGE partitioning by created_at (monthly), with the partial dispatch
        index and BRIN(created_at) defined per-partition, once retention/volume justify it. Left as a single
        physical table in this baseline.
    -->

    <!-- Reference / configuration data -->
    <include file="changes/20260301T000000_create_loan_types.sql" relativeToChangelogFile="true"/>
    <include file="changes/20260301T000010_create_loan_arrangements.sql" relativeToChangelogFile="true"/>

    <!-- Loan lifecycle: application -> disbursement schedule -> sanction -> facility -->
