<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="create-inbox-entries-table" author="platform">
        <createTable tableName="inbox_entries">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="idempotency_key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="command_type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="source_topic" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="text"/>
            <column name="response_payload" type="text"/>
            <column name="response_code" type="int"/>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="retry_count" type="int" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="text"/>
            <column name="error_stacktrace" type="text"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="timestamp with time zone"/>
            <column name="locked_at" type="timestamp with time zone"/>
            <column name="locked_by" type="varchar(255)"/>
            <column name="version" type="int"/>
        </createTable>

        <createIndex tableName="inbox_entries" indexName="idx_inbox_idempotency_key" unique="true">
            <column name="idempotency_key"/>
        </createIndex>

        <createIndex tableName="inbox_entries" indexName="idx_inbox_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="inbox_entries" indexName="idx_inbox_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="inbox_entries" indexName="idx_inbox_status_created">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>