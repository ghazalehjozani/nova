<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1762260999317-1" author="DOTIN\m.amirabdollahi">
        <createTable tableName="loan_facility_accounts">
            <column name="facility_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_facility_accounts"/>
            </column>
            <column name="account_id" type="VARCHAR(255)"/>
            <column name="relation_type" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_facility_accounts"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1762260999317-2" author="DOTIN\m.amirabdollahi">
        <addForeignKeyConstraint baseColumnNames="facility_id" baseTableName="loan_facility_accounts"
                                 constraintName="fk_loan_facility_accounts_on_trade_loan_facility_entity"
                                 referencedColumnNames="id" referencedTableName="loan_facilities"/>
    </changeSet>

</databaseChangeLog>