<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1764506712129-1" author="DOTIN\m.amirabdollahi">
        <createTable tableName="loan_arrangement_confirm_types">
            <column name="loan_arrangement_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="confirm_person_code" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1764506712129-2" author="DOTIN\m.amirabdollahi">
        <addForeignKeyConstraint baseColumnNames="loan_arrangement_id" baseTableName="loan_arrangement_confirm_types"
                                 constraintName="fk_loanarrangementconfirmtypes_on_tradeloanarrangemententity"
                                 referencedColumnNames="id" referencedTableName="loan_arrangements"/>
    </changeSet>
    <changeSet id="1764506712129-7" author="DOTIN\m.amirabdollahi">
        <dropColumn columnName="confirm_person_code" tableName="loan_arrangements"/>

        <dropColumn columnName="define_automatic_installment" tableName="loan_arrangements"/>

        <dropColumn columnName="disbursement_method" tableName="loan_arrangements"/>
    </changeSet>
    <changeSet id="1764506712129-9" author="DOTIN\m.amirabdollahi">
        <dropColumn columnName="disburse_account_holder" tableName="loan_facilities"/>

        <dropColumn columnName="disburse_account_number" tableName="loan_facilities"/>

        <dropColumn columnName="disburse_bank_code" tableName="loan_facilities"/>

        <dropColumn columnName="disburse_branch_code" tableName="loan_facilities"/>

        <dropColumn columnName="disburse_iban" tableName="loan_facilities"/>
    </changeSet>
    <changeSet id="1764510629783-7" author="DOTIN\m.amirabdollahi">
        <dropColumn columnName="auto_approval" tableName="loan_arrangements"/>
    </changeSet>
    <changeSet id="1764515863478-5" author="DOTIN\m.amirabdollahi">
        <dropColumn columnName="segment_type" tableName="loan_types"/>
    </changeSet>
    <changeSet id="1764516773138-1" author="DOTIN\m.amirabdollahi">
        <addUniqueConstraint
                columnNames="application_branch_code, loan_type_code, application_customer_number, derived_value"
                constraintName="uc_tradeloanapplicationentity" tableName="loan_applications"/>
    </changeSet>
    <changeSet id="1764516773138-2" author="DOTIN\m.amirabdollahi">
        <addUniqueConstraint columnNames="loan_type_code" constraintName="uc_tradeloantypeentity"
                             tableName="loan_types"/>
    </changeSet>
    <changeSet id="1764516773138-3" author="DOTIN\m.amirabdollahi">
        <addUniqueConstraint columnNames="sanction_serial_value" constraintName="uc_tradesanctionedloanentity"
                             tableName="sanctioned_loans"/>
    </changeSet>
    <changeSet id="1764516773138-8" author="DOTIN\m.amirabdollahi">
        <dropColumn columnName="respite_serial_value" tableName="loan_applications"/>
    </changeSet>
</databaseChangeLog>