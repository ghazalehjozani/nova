<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1763211975241-2" author="DOTIN\m.amirabdollahi">
        <createTable tableName="loan_disbursement_records">
            <column name="sanctioned_loan_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_loan_disbursement_records"/>
            </column>
            <column name="disbursed_amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="disbursed_currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="disbursed_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="disbursed_by" type="VARCHAR(50)"/>
            <column name="record_order" type="INT">
                <constraints primaryKey="true" primaryKeyName="pk_loan_disbursement_records"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1763211975241-3" author="DOTIN\m.amirabdollahi">
        <createTable tableName="loan_installment_schedule_history_ids">
            <column name="current_schedule_id" type="UUID">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="pk_loan_installment_schedule_history_ids"/>
            </column>
            <column name="previous_schedule_id" type="UUID"/>
            <column name="sequence_order" type="INT">
                <constraints primaryKey="true" primaryKeyName="pk_loan_installment_schedule_history_ids"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1763211975241-4" author="DOTIN\m.amirabdollahi">
        <addColumn tableName="loan_facilities">
            <column name="disburse_account_holder" type="VARCHAR(255)"/>
            <column name="disburse_account_number" type="VARCHAR(255)"/>
            <column name="disburse_bank_code" type="VARCHAR(255)"/>
            <column name="disburse_branch_code" type="VARCHAR(255)"/>
            <column name="disburse_iban" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1763211975241-9" author="DOTIN\m.amirabdollahi">
        <addColumn tableName="loan_installment_schedules">
            <column name="new_installment_count" type="INT"/>
            <column name="preserved_installments_count" type="INT"/>
            <column name="previous_installment_count" type="INT"/>
            <column name="restructured_at" type="DATETIME"/>
            <column name="restructured_by" type="VARCHAR(50)"/>
            <column name="restructuring_amount" type="DECIMAL(19, 4)"/>
            <column name="restructuring_amount_currency" type="VARCHAR(3)"/>
            <column name="restructuring_reason" type="VARCHAR(500)"/>
            <column name="unpaid_installments_count" type="INT"/>
        </addColumn>
    </changeSet>
    <changeSet id="1763211975241-10" author="DOTIN\m.amirabdollahi">
        <addColumn tableName="loan_installments">
            <column name="paid_date" type="DATE"/>
        </addColumn>
    </changeSet>
    <changeSet id="1763211975241-19" author="DOTIN\m.amirabdollahi">
        <addForeignKeyConstraint baseColumnNames="sanctioned_loan_id" baseTableName="loan_disbursement_records"
                                 constraintName="fk_loan_disbursement_records_on_trade_sanctioned_loan_entity"
                                 referencedColumnNames="id" referencedTableName="sanctioned_loans"/>
    </changeSet>
    <changeSet id="1763211975241-20" author="DOTIN\m.amirabdollahi">
        <addForeignKeyConstraint baseColumnNames="current_schedule_id"
                                 baseTableName="loan_installment_schedule_history_ids"
                                 constraintName="fk_loaninstallmentschedulehistoryi_on_installmentscheduleentity"
                                 referencedColumnNames="id" referencedTableName="loan_installment_schedules"/>
    </changeSet>
    <changeSet id="1763211975241-1" author="DOTIN\m.amirabdollahi">
        <dropNotNullConstraint columnDataType="varchar(255)" columnName="currency" tableName="loan_applications"/>
    </changeSet>

</databaseChangeLog>