        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>expression-kit-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>accounting-document-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-ports-inbound</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-ports-outbound</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>checker-qual</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-reconciliation</artifactId>
        </dependency>
        <dependency>
            <!-- LN-59442: wires the generic reconciliation engine (orchestrator + sweep + data-jpa store
                 + /v1/ops/reconciliation), which discovers the recon adapter's Source/Probe/Action beans -->
            <groupId>ir.dotin.platform.pangaea</groupId>
            <artifactId>spring-boot-starter-reconciliation</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform.pangaea</groupId>
            <artifactId>inbox-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform.pangaea</groupId>
