<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>trade-loan</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>trade-loan-container</artifactId>
    <name>Trade Loan :: Container</name>
    <packaging>jar</packaging>

    <properties>
        <start-class>ir.dotin.loan.trade.NovaApplication</start-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-consul-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-consul-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>platform-starter-all</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>expression-kit-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>accounting-document-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-ports-inbound</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-core-application-ports-outbound</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>checker-qual</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-client</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driven-fcb-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>platform-inbox-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>platform-spring-boot-starter-inbox</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driving-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driving-messaging-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.loan</groupId>
            <artifactId>trade-loan-adapters-driving-messaging-activemq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Tracing -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- E2E Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-http-client</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.dotin.platform</groupId>
            <artifactId>platform-envelope-impl-jws</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ir.dotin.loan.trade.NovaApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>ir.dotin.platform</groupId>
                <artifactId>i18n-extractor-maven-plugin</artifactId>
                <version>1.0.0-SNAPSHOT</version>
                <configuration>
                    <basePackage>ir.dotin</basePackage>
                    <outputDirectory>${project.basedir}/src/main/resources/i18n</outputDirectory>
                    <scanDependencies>true</scanDependencies>
                    <locales>
                        <locale/>
                        <locale>en</locale>
<!--                        <locale>fa</locale>-->
                    </locales>
                    <enableAutoTranslation>true</enableAutoTranslation>
                    <translationApiBaseUrl>https://api.deepseek.com</translationApiBaseUrl>
                    <translationModel>deepseek-chat</translationModel>
                    <translationMaxRetries>3</translationMaxRetries>
                    <translationTimeoutSeconds>30</translationTimeoutSeconds>
                    <skipTranslationForEnglish>true</skipTranslationForEnglish>
                </configuration>
            </plugin>
            <plugin>
                <groupId>ir.dotin.platform</groupId>
                <artifactId>spring-config-schema-maven-plugin</artifactId>
                <version>2026.5.15-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>gen-schema</id>
                        <phase>package</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <appName>nova</appName>
                            <output>${project.build.directory}/nova.schema.json</output>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-schema</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/nova.schema.json</file>
                                    <type>json</type>
                                    <classifier>schema</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
