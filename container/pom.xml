<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ir.dotin.loan</groupId>
    <artifactId>trade-loan</artifactId>
    <version>2025.11.3-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>trade-loan-container</artifactId>
  <name>Trade Loan :: Container</name>
  <packaging>jar</packaging>

  <properties>
      <start-class>ir.dotin.loan.trade.Main</start-class>
  </properties>

  <dependencies>
    <dependency>
        <groupId>ir.dotin.platform</groupId>
        <artifactId>platform-starter-all</artifactId>
    </dependency>
    <dependency>
      <groupId>ir.dotin.loan</groupId>
      <artifactId>trade-loan-core-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>ir.dotin.loan</groupId>
      <artifactId>trade-loan-core-application-service</artifactId>
    </dependency>
    <dependency>
      <groupId>ir.dotin.loan</groupId>
      <artifactId>trade-loan-core-application-ports-inbound</artifactId>
    </dependency>
    <dependency>
      <groupId>ir.dotin.loan</groupId>
      <artifactId>trade-loan-core-application-ports-outbound</artifactId>
    </dependency>
    <dependency>
      <groupId>ir.dotin.loan</groupId>
      <artifactId>trade-loan-adapters-driven-persistence</artifactId>
    </dependency>
    <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <exclusions>
            <exclusion>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
            </exclusion>
        </exclusions>
    </dependency>
    <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>trade-loan-adapters-driven-fcb-client</artifactId>
    </dependency>
    <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>trade-loan-adapters-driven-formula</artifactId>
    </dependency>
    <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>trade-loan-adapters-driving-rest</artifactId>
    </dependency>
    <dependency>
        <groupId>ir.dotin.loan</groupId>
        <artifactId>trade-loan-adapters-driven-messaging</artifactId>
    </dependency>
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-starter-bootstrap</artifactId>
    </dependency>
  </dependencies>

  <build>
      <plugins>
          <plugin>
              <groupId>ir.dotin.platform</groupId>
              <artifactId>i18n-extractor-maven-plugin</artifactId>
              <version>1.0.0-SNAPSHOT</version>
              <configuration>
                  <basePackage>ir.dotin</basePackage>
                  <outputDirectory>${project.basedir}/src/main/resources</outputDirectory>
                  <scanDependencies>true</scanDependencies>
                  <locales>
                      <locale/>
                      <locale>en</locale>
                      <locale>fa</locale>
                      <locale>ar</locale>
                      <locale>ru</locale>
                  </locales>
                  <enableAutoTranslation>true</enableAutoTranslation>
                  <translationApiBaseUrl>https://api.deepseek.com</translationApiBaseUrl>
                  <translationModel>deepseek-chat</translationModel>
                  <translationMaxRetries>3</translationMaxRetries>
                  <translationTimeoutSeconds>30</translationTimeoutSeconds>
                  <skipTranslationForEnglish>true</skipTranslationForEnglish>
              </configuration>
          </plugin>
      </plugins>
  </build>
</project>
