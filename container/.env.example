# =============================================================================
# .env.example — copy to .env (git-ignored) and fill in real values for local dev
# -----------------------------------------------------------------------------
# In production, these are injected by the orchestrator / secrets manager.
# Nothing here is ever committed. Nothing here is ever stored in Consul.
# =============================================================================

# --- Spring profile -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev,kafka-fcb

# --- Consul connection --------------------------------------------------------
CONSUL_HOST=consul.nova.local
CONSUL_PORT=8500
CONSUL_SCHEME=http
CONSUL_ACL_TOKEN=
CONSUL_TLS_ENABLED=false
CONSUL_TLS_CERT_PATH=
CONSUL_TLS_TRUSTSTORE_TYPE=JKS
CONSUL_TLS_TRUSTSTORE_PASSWORD=

# --- Datasource ---------------------------------------------------------------
DB_HOST=postgres.nova.local
DB_PORT=5432
DB_NAME=nova
DB_USERNAME=
DB_PASSWORD=

# --- Redis (Sentinel HA) DOCKER COMPOSE USED ONLY ------------------------------------------------------
# Sentinel announces master/replica/sentinel addresses to clients.
# Set announce-host to a value reachable from the APP. Three scenarios:
#   1) App + Redis on same Docker network  -> defaults (container names) work.
#   2) App outside Docker, same host       -> use host.docker.internal (add to /etc/hosts on Linux:
#                                              `127.0.0.1 host.docker.internal`) OR LAN IP.
#   3) App + Redis on separate hosts       -> use public DNS / routable IP of each Redis host
#                                              and set the externally-mapped ports.

REDIS_MASTER_NAME=nova-master
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# Sentinel endpoints the app uses to discover the topology.
REDIS_SENTINEL_NODES=host.docker.internal:26379,host.docker.internal:26380,host.docker.internal:26381

# -- DOCKER COMPOSE USED ONLY: --

# Host-side port mappings (used by docker-compose).
REDIS_MASTER_PORT=6379
REDIS_REPLICA_1_PORT=6380
REDIS_REPLICA_2_PORT=6381
REDIS_SENTINEL_1_PORT=26379
REDIS_SENTINEL_2_PORT=26380
REDIS_SENTINEL_3_PORT=26381

# Address sentinels use to monitor master (must be reachable from sentinel container).
REDIS_MASTER_MONITOR_HOST=host.docker.internal
REDIS_MASTER_MONITOR_PORT=6379

# Address sentinel announces to clients for replicas + itself + master (via monitor host).
REDIS_REPLICA_1_ANNOUNCE_HOST=host.docker.internal
REDIS_REPLICA_1_ANNOUNCE_PORT=6380
REDIS_REPLICA_2_ANNOUNCE_HOST=host.docker.internal
REDIS_REPLICA_2_ANNOUNCE_PORT=6381
REDIS_SENTINEL_1_ANNOUNCE_HOST=host.docker.internal
REDIS_SENTINEL_1_ANNOUNCE_PORT=26379
REDIS_SENTINEL_2_ANNOUNCE_HOST=host.docker.internal
REDIS_SENTINEL_2_ANNOUNCE_PORT=26380
REDIS_SENTINEL_3_ANNOUNCE_HOST=host.docker.internal
REDIS_SENTINEL_3_ANNOUNCE_PORT=26381

# --- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_USER=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_CONSUMER_GROUP=core.loan.nova.fcb-integration.v1

# --- ActiveMQ -----------------------------------------------------------------
ACTIVEMQ_HOST=activemq.nova.local
ACTIVEMQ_PORT=61616
ACTIVEMQ_USER=
ACTIVEMQ_PASSWORD=

# --- FCB integration (Deprecated Usecase runner) ----------------------------------------------------------
FCB_BASE_URL=
FCB_USERNAME=
FCB_PASSWORD=

# --- OAuth2 / OIDC ------------------------------------------------------------
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET==

ENVELOPE_SIGNER_PRIVATE_KEY_REF=file:/home/m.amirabdollahi/workspaces/trade-loan/container/keystore.p12
ENVELOPE_KEYSTORE_PASSWORD=changeit
ENVELOPE_KEY_PASSWORD=changeit

# --- Observability (OpenTelemetry) -------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.100.7.20:8200
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer Unmasking-Activist5-Unsecured
OTEL_AUTH_HEADER=Bearer Unmasking-Activist5-Unsecured
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=10000
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
OTEL_SERVICE_NAME=nova-service
OTEL_SERVICE_NAMESPACE=nova
OTEL_PROPAGATORS=tracecontext,baggage
KUBERNETES_NAMESPACE=
KUBERNETES_POD_NAME=
HOSTNAME=

# --- Platform -----------------------------------------------------------------
PLATFORM_ENV=dev
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false

