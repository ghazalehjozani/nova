# =============================================================================
# .env.example — copy to .env (git-ignored) and fill in real values for local dev
# -----------------------------------------------------------------------------
# This file holds Nova runtime values plus opt-in local build/publication inputs.
# The local infra containers (postgres and broker) and their docker-compose-only
# env now live in the sibling repo nova-dev-stack/. Its Sentinel services are not
# compatible with Nova's Cluster-only client.
# Connection secrets shared with the supported services must stay in sync:
#   DB_NAME, DB_USERNAME, DB_PASSWORD, ARTEMIS_USER, ARTEMIS_PASSWORD
# In production these are injected by the orchestrator / secrets manager.
# Nothing here is ever committed. Nothing here is ever stored in Consul.
# =============================================================================

# --- Artifact and image publication ------------------------------------------
# Pulls and base-image resolution use the Docker group; pushes use hosted.
# Credentials are required and are read only through `docker login --password-stdin`.
NEXUS_PULL_REGISTRY=nexus3.dotin.ir:7111
NEXUS_PULL_USERNAME=
NEXUS_PULL_PASSWORD=
NEXUS_PUSH_REGISTRY=nexus3.dotin.ir:7110
NEXUS_PUSH_USERNAME=
NEXUS_PUSH_PASSWORD=
NEXUS_APT_REPO_URL=https://nexus3.dotin.ir/repository/Ubuntu

# Maven settings must define server ids `releases` and `snapshots`. Prefer
# ${env.NEXUS_MAVEN_USERNAME}/${env.NEXUS_MAVEN_PASSWORD} in settings.xml.
# Blank MAVEN_SETTINGS defaults to ~/.m2/settings.xml.
MAVEN_SETTINGS=
NEXUS_MAVEN_USERNAME=
NEXUS_MAVEN_PASSWORD=
NEXUS_MAVEN_RELEASE_URL=https://nexus.dotin.ir/nexus/content/repositories/CoreRelease
NEXUS_MAVEN_SNAPSHOT_URL=https://nexus.dotin.ir/nexus/content/repositories/CoreSnapshots

# Image builds use a temporary context and require corporate CA certificates
# plus the application keystore. Keep both paths outside the Git worktree.
IMAGE_CA_CERTS_DIR=
NOVA_KEYSTORE_PATH=

# --- Spring profile -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- Consul connection --------------------------------------------------------
CONSUL_HOST=consul.nova.local
CONSUL_PORT=8500
CONSUL_TOKEN=

# --- Datasource (client). DB_NAME/USERNAME/PASSWORD duplicated in nova-dev-stack/.env -----------
DB_URL=jdbc:postgresql://10.100.7.20:5433,10.100.7.20:5434/novadb?targetServerType=preferPrimary&loadBalanceHosts=true
DB_USERNAME=
DB_PASSWORD=

# --- Redis client (Cluster) --------------------------------------------------
# Every address advertised by CLUSTER SHARDS must be reachable from the Nova process.
REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379,redis-3:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# --- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_USER=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_CONSUMER_GROUP=core.loan.nova.fcb-integration.v1

# --- FCB Artemis broker connection (client; address/user/pass ONLY) ---
# ARTEMIS_USER/PASSWORD duplicated in nova-dev-stack/.env (broker bootstrap) — keep in sync.
# The active transport (transport-mode) + artemis.enabled live in Consul/nova-config, NOT here.
ACTIVEMQ_HOST=artemis.nova.local
ACTIVEMQ_PORT=61616
ARTEMIS_USER=
ARTEMIS_PASSWORD=

# --- OAuth2 / OIDC ------------------------------------------------------------
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET==

# Envelope-signing keystore: provided at runtime from the secret store (Vault / k8s secret), never committed.
# Point the ref at the mounted secret path; passwords are injected as env vars, no default.
ENVELOPE_SIGNER_PRIVATE_KEY_REF=file:/run/secrets/envelope-keystore.p12
ENVELOPE_KEYSTORE_PASSWORD=
ENVELOPE_KEY_PASSWORD=

# --- MCP (Model Context Protocol) endpoint API keys --------------------------
# Per-endpoint static bearer tokens (Authorization: Bearer <token>):
#   /v1/mcp      (business read tools) uses MCP_BUSINESS_TOKEN
#   /v1/ops/mcp  (ops admin tools)     uses MCP_OPS_TOKEN
# Distinct secrets (least-privilege). Blank => that endpoint is fail-closed (every request 401s).
# Bound in Consul via ${MCP_BUSINESS_TOKEN}/${MCP_OPS_TOKEN}; the real values live only here (.env, git-ignored).
# Generate a strong url-safe token (>= 32 bytes entropy), e.g.:
#   openssl rand -base64 36 | tr -d '=+/' | cut -c1-40      # 40-char url-safe
#   openssl rand -hex 32                                    # 64-char hex
MCP_BUSINESS_TOKEN=
MCP_OPS_TOKEN=

# --- Observability (OpenTelemetry) -------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.100.7.20:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer *
OTEL_AUTH_HEADER=Bearer *
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=10000
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
OTEL_SERVICE_NAME=nova-service
OTEL_SERVICE_NAMESPACE=nova
OTEL_PROPAGATORS=tracecontext,baggage
KUBERNETES_NAMESPACE=
KUBERNETES_POD_NAME=
HOSTNAME=

# --- Platform -----------------------------------------------------------------
PLATFORM_ENV=dev
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false

SERVER_PORT=8080
DEFAULT_IP_ADDRESS=
