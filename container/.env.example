FCB_PASSWORD=abcd1234

# Security
ENCRYPTION_PASSWORD=CHANGE_ME

# Logging
LOG_LEVEL_WEB=DEBUG
LOG_LEVEL_APP=DEBUG

# JPA
HIBERNATE_DDL_AUTO=none
SHOW_SQL=true

# OTEL
