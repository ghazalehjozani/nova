{
  "name": "Nova DevContainer",
  "image": "nexus3.dotin.ir:7111/expenditures/devcontainer-java:2026.2.24-jdk25",
  // ── Workspace ─────────────────────────────────────────────────────────────
  // IMPORTANT: workspaceFolder MUST be unique per project.
  // IntelliJ Gateway identifies remote projects by path — if two containers
  // both use /workspace, Gateway says "Reusing already opened project" and
  // refuses to open the second one. Using /workspace/<project> fixes this.
  //
  // PERF: Removed `consistency=cached` — it is a macOS Docker Desktop
  //       feature (OSXFS/VirtioFS) and is silently ignored on native Linux.
  //       On Linux, bind mounts are already native filesystem speed.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/nova,type=bind",
  "workspaceFolder": "/workspace/nova",
  // ── User ──────────────────────────────────────────────────────────────────
  "remoteUser": "developer",
  "containerUser": "developer",
  "updateRemoteUserUID": true,
  // PERF: Changed from `loginInteractiveShell` to `loginShell`.
  //       `loginInteractiveShell` spawns a FULL interactive ZSH session
  //       (Oh-My-Zsh, Powerlevel10k, all plugins, completions) every time
  //       the IDE probes for environment variables — which IntelliJ does
  //       repeatedly. `loginShell` reads .zprofile/.zlogin for PATH/exports
  //       without loading interactive shell machinery. The devcontainer spec
  //       itself warns about "the performance impact" of interactive probing.
  "userEnvProbe": "loginShell",
  // ── Container Behavior ────────────────────────────────────────────────────
  "overrideCommand": false,
  "init": true,
  "shutdownAction": "stopContainer",
  // ── Lifecycle ─────────────────────────────────────────────────────────────
  // PERF: Changed from `postStartCommand` to `updateContentCommand`.
  //       With `postStartCommand`, the IDE waits for post-start.sh to finish
  //       before connecting — blocking the developer. With `updateContentCommand`,
  //       the IDE connects immediately while postStartCommand runs in background.
  //       Safe because post-start.sh is environment enrichment, not workspace setup.
  "waitFor": "updateContentCommand",
  "postStartCommand": "/usr/local/bin/post-start.sh",
  // ── Mounts ────────────────────────────────────────────────────────────────
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind",
    "source=${localEnv:HOME},target=/host-home,type=bind,readonly",
    // PERF: Removed `consistency=cached` — no-op on native Linux Docker.
    "source=${localEnv:HOME}/.m2/repository,target=/home/developer/.m2/repository,type=bind",
    "source=${devcontainerId}-gradle-cache,target=/home/developer/.gradle,type=volume",
    "source=${devcontainerId}-npm-cache,target=/home/developer/.npm,type=volume",
    "source=${devcontainerId}-zsh-history,target=/home/developer/.zsh_history_vol,type=volume"
  ],
  // ── Environment ───────────────────────────────────────────────────────────
  "containerEnv": {
    "SOURCE_SOCKET": "/var/run/docker-host.sock",
    "TARGET_SOCKET": "/var/run/docker.sock",
    "ENABLE_NONROOT_DOCKER": "true",
    "NONROOT_USER": "developer",
    "HOST_HOME": "/host-home",
    "SHELL": "/bin/zsh",
    "TERM": "xterm-256color",
    "HISTFILE": "/home/developer/.zsh_history_vol/.zsh_history",
    "SPRING_DATASOURCE_URL": "jdbc:postgresql://host.docker.internal:5433/trade_loan",
    "KAFKA_BOOTSTRAP_SERVERS": "host.docker.internal:9092",
    "SPRING_DATA_REDIS_HOST": "host.docker.internal",
    "SPRING_DATA_REDIS_PORT": "6379"
  },
  "remoteEnv": {
    "GPG_TTY": "${containerEnv:TTY}",
    "SPRING_PROFILES_ACTIVE": "${localEnv:SPRING_PROFILES_ACTIVE:dev}",
    "SPRING_DATASOURCE_USERNAME": "${localEnv:POSTGRES_USER:trade_loan}",
    "SPRING_DATASOURCE_PASSWORD": "${localEnv:POSTGRES_PASSWORD:trade_loan}"
  },
  // ── Security & Capabilities ───────────────────────────────────────────────
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  // ── Docker Run Arguments ──────────────────────────────────────────────────
  "runArgs": [
    "--hostname=nova-dev",
    "--add-host=host.docker.internal:host-gateway",
    // PERF: Increased from 4g → 8g. IntelliJ backend alone needs 1.5–3 GB.
    //       Add JDK compiler, Maven daemon, Git, ZSH — 4 GB forces the kernel
    //       into aggressive page cache eviction. The CPU spikes during indexing
    //       are memory pressure (kswapd) masquerading as CPU load.
    "--memory=8g",
    "--cpus=5.0",
    // PERF: tmpfs for /tmp — eliminates overlay2 write amplification.
    //       IntelliJ writes heavily to /tmp during indexing (temp index segments,
    //       decompiled stubs, analysis caches). Without tmpfs, every write goes
    //       through overlay2 CoW which has significant metadata overhead.
    //       `exec` flag required — Java creates and executes temp files.
    "--tmpfs", "/tmp:exec,size=2g",
    // PERF: Increased from default 64m → 512m. JVM uses /dev/shm for NIO
    //       mapped buffers; IntelliJ UI rendering uses it for compositing.
    //       64 MB is easily exhausted during heavy indexing + compilation.
    "--shm-size=512m",
    "--name",
    "nova-devcontainer"
  ],
  // ── Port Forwarding ───────────────────────────────────────────────────────
  "forwardPorts": [
    8080,
    5005
  ],
  "portsAttributes": {
    "8080": {
      "label": "Spring Boot",
      "onAutoForward": "notify"
    },
    "5005": {
      "label": "Java Debug (JDWP)",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  // ── IDE ───────────────────────────────────────────────────────────────────
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ",
      "plugins": [
        "com.intellij.spring",
        "org.jetbrains.plugins.yaml",
        "com.intellij.java",
        "Docker",
        "org.jetbrains.plugins.terminal",
        "com.intellij.database"
      ]
    },
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "redhat.vscode-yaml"
      ]
    }
  },
  // ── Host Requirements ─────────────────────────────────────────────────────
  "hostRequirements": {
    "cpus": 5,
    "memory": "12gb",
    "storage": "12gb"
  }
}